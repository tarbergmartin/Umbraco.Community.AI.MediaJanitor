<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Allow floating versions so extensions can align with the host Umbraco project's package versions -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Umbraco API packages - Used by extension templates -->
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="17.3.5" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="17.3.5" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="17.3.5" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="17.3.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- AI abstractions. The concrete IChatClient is provided by the host site
         (e.g. via Umbraco.AI.OpenAI, Umbraco.AI.Anthropic, ...). -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="9.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="9.10.0" />
  </ItemGroup>
</Project>

<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Allow floating versions so extensions can align with the host Umbraco project's package versions -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Umbraco API packages - Used by extension templates -->
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="17.3.5" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="17.3.5" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="17.3.5" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="17.3.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.AI abstractions for ChatMessage / DataContent etc. -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.2.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.2.0" />
    <!-- Umbraco.AI exposes IAIChatService which we use to obtain an IChatClient
         based on the Connection/Profile configured in the backoffice. -->
    <PackageVersion Include="Umbraco.AI.Core" Version="1.10.1" />
  </ItemGroup>
</Project>
